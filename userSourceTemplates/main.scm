(define (sieve limit)
  (let loop ((flags (make-vector (+ limit 1) #t)) (number 2))
    (if (> (* number number) limit)
        (let collect ((index 2) (primes '()))
          (if (> index limit)
              (reverse primes)
              (collect (+ index 1)
                       (if (vector-ref flags index) (cons index primes) primes))))
        (begin
          (if (vector-ref flags number)
              (let mark ((multiple (* number number)))
                (if (<= multiple limit)
                    (begin
                      (vector-set! flags multiple #f)
                      (mark (+ multiple number))))))
          (loop flags (+ number 1))))))

(define (sum values)
  (if (null? values)
      0
      (+ (car values) (sum (cdr values)))))

(define (rolling-sums values width)
  (let loop ((window values) (totals '()))
    (if (< (length window) width)
        (reverse totals)
        (loop (cdr window) (cons (sum (take window width)) totals)))))

(define (take values count)
  (if (or (= count 0) (null? values))
      '()
      (cons (car values) (take (cdr values) (- count 1)))))

(define (residue-class value modulus)
  (modulo value modulus))

(display "WASMVerse Scheme showcase")
(newline)
(display "Stage one: recursive prime sieve")
(newline)
(define primes (sieve 400))
(display "prime count up to 400: ")
(display (length primes))
(newline)
(display "largest prime: ")
(display (car (reverse primes)))
(newline)
(display "Stage two: rolling windows")
(newline)
(define windows (rolling-sums primes 10))
(display "window count: ")
(display (length windows))
(newline)
(display "first windows: ")
(display (take windows 4))
(newline)
(display "Stage three: residue classes")
(newline)
(define (count-residue values modulus target)
  (let loop ((remaining values) (total 0))
    (if (null? remaining)
        total
        (loop (cdr remaining)
              (if (= (residue-class (car remaining) modulus) target)
                  (+ total 1)
                  total)))))
(display "residue zero under 7: ")
(display (count-residue primes 7 0))
(newline)
(display "residue zero under 5: ")
(display (count-residue primes 5 0))
(newline)
(display "Stage four: higher-order folding")
(newline)
(define squares (map (lambda (value) (* value value)) (take primes 10)))
(display "square heads: ")
(display squares)
(newline)
(display "sum of square heads: ")
(display (sum squares))
(newline)
(display "Showcase complete.")
(newline)
