{
    "name": "wasmverse",
    "type": "module",
    "private": true,
    "bin": {
        "wasmverse": "./bin/wasmverse.mjs",
        "wasmverse-mcp": "./bin/wasmverse-mcp.mjs"
    },
    "packageManager": "pnpm@12.4.1",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "tsx scripts/DevelopmentLauncherScript.ts",
        "build": "tsx scripts/ProductionBuildScript.ts",
        "cli": "tsx scripts/WasmverseCliScript.ts",
        "mcp": "tsx scripts/WasmverseMcpServer.ts",
        "start": "node dist/server/ServerEntryPoint.js",
        "setup": "tsx scripts/SetupLocalToolchainsScript.ts",
        "format": "oxfmt .",
        "format:check": "oxfmt --check .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "verify:export": "tsx scripts/VerifyStaticExportsScript.ts"
    },
    "dependencies": {
        "@bjorn3/browser_wasi_shim": "^0.4.2",
        "@codemirror/commands": "^6.11.1",
        "@codemirror/lang-cpp": "^6.0.3",
        "@codemirror/lang-go": "^6.0.1",
        "@codemirror/lang-java": "^6.0.2",
        "@codemirror/lang-javascript": "^6.2.5",
        "@codemirror/lang-php": "^6.0.2",
        "@codemirror/lang-python": "^6.2.1",
        "@codemirror/lang-rust": "^6.0.2",
        "@codemirror/lang-sql": "^6.10.0",
        "@codemirror/language": "^6.13.1",
        "@codemirror/legacy-modes": "^6.5.5",
        "@codemirror/state": "^6.7.6",
        "@codemirror/view": "^6.43.14",
        "@duckdb/duckdb-wasm": "1.32.0",
        "@electric-sql/pglite": "0.5.9",
        "@ethereumjs/evm": "10.1.3",
        "@ethereumjs/util": "10.1.3",
        "@fontsource/eb-garamond": "^5.3.0",
        "@fontsource/noto-sans": "^5.3.0",
        "@lezer/highlight": "^1.2.5",
        "@modelcontextprotocol/sdk": "^1.32.1",
        "@noble/hashes": "^2.4.0",
        "@ruby/3.4-wasm-wasi": "^2.10.1",
        "@ruby/wasm-wasi": "^2.10.1",
        "@sqlite.org/sqlite-wasm": "3.53.4-build2",
        "@xterm/addon-fit": "^0.11.0",
        "@xterm/xterm": "^6.0.0",
        "apache-arrow": "^17.0.0",
        "assemblyscript": "^0.28.20",
        "biwascheme": "^0.8.3",
        "cherry-cljs": "^0.6.38",
        "esbuild": "^0.28.2",
        "fflate": "^0.8.3",
        "flatbuffers": "^24.12.23",
        "jscl": "0.9.0-alpha.0",
        "php-wasm": "^0.1.0",
        "pyodide": "^314.0.7",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "solc": "0.8.37",
        "tau-prolog": "^0.3.4",
        "tslib": "^2.8.1",
        "wasmoon": "^1.16.0",
        "webr": "^0.6.0"
    },
    "devDependencies": {
        "@types/node": "^26.6.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "oxfmt": "^0.68.0",
        "tsx": "^4.23.15",
        "typescript": "6.0.3",
        "vite": "^8.3.0",
        "vitest": "^5.0.3"
    }
}
